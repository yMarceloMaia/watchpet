pkgname=catwatch
pkgver=1.2.1
pkgrel=1
pkgdesc="Acompanha os gatos e controla o servidor Catwatch deste PC"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'libnotify')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/catwatch "$pkgdir/usr/bin/catwatch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/catwatch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/catwatch.svg"
  install -Dm644 "$startdir/catwatch.desktop" "$pkgdir/usr/share/applications/catwatch.desktop"
}
