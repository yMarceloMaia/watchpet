pkgname=catwatch
pkgver=1.0.0
pkgrel=1
pkgdesc='Painel leve para acompanhar os gatos (cliente do servidor Catwatch)'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/catwatch "$pkgdir/usr/bin/catwatch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/catwatch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/catwatch.svg"
  install -Dm644 "$startdir/catwatch.desktop" "$pkgdir/usr/share/applications/catwatch.desktop"
}
